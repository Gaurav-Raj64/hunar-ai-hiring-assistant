# Hunar Voice AI API Key (keep secret - never commit!)
HUNAR_API_KEY=your-api-key-here

# Server Port
PORT=3001

# Frontend URL (for CORS)
CLIENT_URL=http://localhost:5173

# Mode: "live" uses real Hunar API, "sandbox" uses built-in simulator
# When API key is invalid/expired, automatically falls back to sandbox
API_MODE=live
